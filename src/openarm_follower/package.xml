  <version>0.1.0</version>
  <description>OpenArm v1.0 팔로워 bringup — hardware 인자로 mock 과 CAN-FD 실기를 고른다.</description>
  <maintainer email="woolim@pinklab.art">Woolim Park</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

