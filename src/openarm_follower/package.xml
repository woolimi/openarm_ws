<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_follower</name>
  <version>0.1.0</version>
  <description>OpenArm v1.0 팔로워 bringup 과 중력보상 캘리브레이션 CLI.</description>
  <maintainer email="woolim@pinklab.art">Woolim Park</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>pinocchio</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openarm_bringup</exec_depend>
  <exec_depend>openarm_description</exec_depend>
  <exec_depend>openarm_leader</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
